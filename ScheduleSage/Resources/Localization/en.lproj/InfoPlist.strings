/* App Name */
CFBundleDisplayName = "ScheduleSage";

/* Calendar Usage Description */
NSCalendarsUsageDescription = "ScheduleSage needs calendar access to help you add, view and manage your events easily. This allows the app to create new events based on your input and organize your schedule efficiently.";

/* Notifications Usage Description */
NSUserNotificationsUsageDescription = "This app needs to send notifications to keep you updated about calendar events.";

/* Permission Descriptions */
NSMicrophoneUsageDescription = "ScheduleSage needs access to your microphone to convert your voice into text and identify schedule information. You can change this permission at any time in system settings.";
